SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Browser-visible Supabase config for auth (@supabase/ssr).
# The URL is duplicated from SUPABASE_URL on purpose: NEXT_PUBLIC_* vars are
# inlined into the client bundle at build time, they are not runtime reads.
# Use the publishable key (sb_publishable_...) or the legacy anon key.
# NEVER prefix SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Phone agent (Africa's Talking) ---
# Secret added to every AT callback URL; AT doesn't sign requests, so this is
# what stops strangers from hitting /api/voice/*. Generate: openssl rand -hex 24
VOICE_WEBHOOK_TOKEN=
# Public URL AT can reach (tunnel in dev, deployment URL in prod). Falls back to the request origin.
PUBLIC_BASE_URL=
# Only needed if AT recording links turn out to require auth.
AT_API_KEY=
# Optional: Google TTS voice for <Say>, dialing country code for local agent numbers, models.
AT_VOICE=en-US-Standard-C
AT_COUNTRY_CODE=254
VOICE_MODEL=gpt-4o-mini
VOICE_STT_MODEL=gpt-4o-mini-transcribe
# Shown on the landing page as "Call +254…" when set.
NEXT_PUBLIC_VOICE_NUMBER=

# --- In-app voice call (/call) ---
# Optional overrides for the reply voice (OpenAI TTS).
APP_TTS_MODEL=gpt-4o-mini-tts
APP_TTS_VOICE=alloy

# --- Twilio (free trial works: <Gather> speech + <Say>) ---
# Number/TwiML App "A call comes in" -> POST https://<host>/api/voice/twilio
# "Call status changes"              -> POST https://<host>/api/voice/twilio/status
# Signatures are checked against PUBLIC_BASE_URL, so set it to the exact public host Twilio calls.
TWILIO_AUTH_TOKEN=
TWILIO_VOICE=Polly.Joanna-Neural
# Browser calling via @twilio/voice-sdk (no phone number): /api/voice/twilio/token
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# --- Emmere: WhatsApp restaurant ordering ---
# Chat model. Gemini writes Luganda best. Either a Google AI Studio key
# (direct) or the Vercel AI Gateway key; OpenAI (above) is the fallback.
# Note: the gateway's free tier allows only 5 Gemini requests per minute.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
CHAT_MODEL=gemini-2.5-flash
CHAT_FALLBACK_MODEL=gpt-4o-mini
# Voice notes. Sunbird AI (Uganda) transcribes Luganda + English: api.sunbird.ai
SUNBIRD_API_KEY=
# Optional fallback speech-to-text that also supports Luganda.
ELEVENLABS_API_KEY=
# Restaurant the public /try demo talks to (seeded by 0003_restaurants.sql).
DEMO_RESTAURANT_SLUG=mama-rose-kitchen

# --- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp) ---
# Webhook: https://<PUBLIC_BASE_URL>/api/whatsapp/webhook, subscribe to "messages".
# PUBLIC_BASE_URL (above) must be set: WhatsApp fetches menu images by URL.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
